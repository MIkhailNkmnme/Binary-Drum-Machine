@echo off
rem Уборка хранилища git: сжимает историю и выбрасывает лишние объекты.
rem Запускать, когда папка никем не занята — иначе Windows не даст удалить файлы.
rem Обычное обновление в этом не нуждается, достаточно раза в пару месяцев.
cd /d "%~dp0"
echo.
echo === Zerkalius: сжатие хранилища git ===
echo.
git gc --prune=now
if errorlevel 1 (
  echo.
  echo Не вышло. Закройте редакторы и браузер с этой папкой, добавьте её
  echo в исключения антивируса и попробуйте снова.
) else (
  echo.
  echo Готово.
)
echo.
pause
